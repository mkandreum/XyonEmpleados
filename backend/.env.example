# Server Configuration
PORT=3000
NODE_ENV=production

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/xyonempleados_db"

# Security - JWT (REQUIRED - Generate with: openssl rand -base64 64)
JWT_SECRET="CHANGE_THIS_TO_A_SUPER_SECRET_KEY_GENERATE_WITH_OPENSSL"

# Security - Admin Initial Password (REQUIRED - Generate with: openssl rand -base64 32)
ADMIN_EMAIL="admin@xyonempleados.com"
ADMIN_INITIAL_PASSWORD="CHANGE_THIS_SECURE_PASSWORD"

# CORS - Frontend URL (REQUIRED in production)
FRONTEND_URL="https://yourdomain.com"

# Encryption key for SMTP password at rest (REQUIRED - openssl rand -base64 32)
ENCRYPTION_KEY="CHANGE_THIS_BASE64_32_BYTES"

# Web Push (optional - npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# Only for self-signed SMTP certificates (insecure)
# SMTP_TLS_INSECURE=true
