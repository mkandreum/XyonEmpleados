<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. No cleartext; user-installed CAs are NOT trusted.
     Pinning-ready: uncomment and set the real SPKI SHA-256 pins and expiration. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
